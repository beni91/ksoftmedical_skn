<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<record id="view_blocoperatoire_tree" model="ir.ui.view">
		<field name="name">module.blocoperatoire.tree</field>
		<field name="model">module.blocoperatoire</field>
		<field eval="8" name="priority"/>
		<field name="arch" type="xml">
			<tree string="Liste Intervention" sample="1" multi_edit="1">
				<field name="bloc_name" />
				<field name="date_intervention"/>
				<field name="heure_intervention" invisible="1"/>
				<field name="patient_id"/>
				<field name="age"/>
				<field name="doctor" optional="show"/>
                <field name="state" />
			</tree>
		</field>
	</record>


	<record id="view_blocoperatoire_form" model="ir.ui.view">
		<field name="name">module.blocoperatoire.form</field>
		<field name="model">module.blocoperatoire</field>
		<field name="arch" type="xml">
			<form>
                <header>
					<field name="state" widget="statusbar"/>

					<!--button name="" class="oe_highlight" type="object" attrs="{'invisible': [('state', '=', 'confirme')]}"
						string="Terminer" />
					<button name="" type="object"
						string="Annuler" /-->
				</header>
				<sheet>

					<div class="oe_title mb24" string="Identité Patient">
						<div id="header_left_group">
							<h1>
								<field id="bloc_name" class="o_text_overflow" name="bloc_name" readoly="1" force_save="1"/>
								<field id="patient_id" class="o_text_overflow" name="patient_id"/>
							</h1>
						</div>
					</div>
					<group>
						<group id="header_left_group">
							<field name="dob" force_save="1"/>
							<field name="age" force_save="1"/>
							<field name="sex" force_save="1"/>
						</group>
						<group id="header_right_group">
							<field name="doctor"/>
							<field name="assistant_doctor" 
								widget="many2many_tags" options="{'no_create_edit': True}"/>
							<field name="infirmiers"
								widget="many2many_tags" options="{'no_create_edit': True}"/>
						</group>
					</group>
					<group string="Info sur Intervention">
						<group id="header_left_group">
							<field name="actes" 
								widget="Many2one"  domain="[('is_actes_medicaux','=',True)]"/>
						</group>
						<group id="header_right_group">
							<field name="date_intervention"/>
							<field name="heure_intervention"/>
							<field name="heure_debut"/>
							<field name="heure_fin"/>
						</group>
					</group>
					<group>
						<group id="header_left_group">
							<field name="diagnostic_pre"/>
						</group>
						<group id="header_right_group">
							<field name="diagnostic_post"/>
						</group>
					</group>

					<notebook colspan="4">
						<page string="Anamnèse Infirmiere" autofocus="autofocus">
							<notebook>
								<page string="CheckList">
									<group>
										<group id="header_left_group" string="Jour J-1">
											<field name="disponibilite" />
											<field name="proprete" />
											<field name="accueil" />
											<field name="parametres" />
											<field name="rasage" />
											<field name="douche" />
											<field name="administrer" />
											<field name="informer" />
											<field name="information" />
										</group>
										<group id="header_right_group" string="Jour J-0">
											<field name="reveil" />
											<field name="douchepreop" />
											<field name="blouse" />
											<field name="jeune" />
											<field name="premedication" />
											<field name="changement" />
										</group>
									</group>
								</page>
								<page string="Antécedents">
									<!--field name="antecedent_id"/-->
								</page>
							</notebook>
						</page>
						<page string="Bloc Opératoire" autofocus="autofocus">
							<notebook>
								<page string="Compte Rendu">
									<group>
										<group id="header_left_group">
											<field name="compte_rendu" />
											<field name="incident" />
										</group>
										<group id="header_right_group">
											<field name="instruction_postop" />
											<field name="traitement" />
										</group>
									</group>
								</page>
								<page string="Feuille Anesthésique">
								</page>
							</notebook>
						</page>
						<page string="Fiche de stock">
							<group string="Fiche de stock">
								<field name="bloc_fiche_stock" 
									context="{'default_patient_id': patient_id}" 
									nolabel="1">
									<tree editable="bottom"
										attrs="{'readonly': [('internal_status', '=', 'done')]}">
										<field name="date_consommation" />
										<field name="produit" domain="['|',('is_medicaments','=',True),
																			('is_materiels','=',True)]"/>
										<field name="qtity" />
										<field name="categorie"/>
										<field name="infirmier"/>
										<field name="internal_status" />
									</tree>
								</field>
							</group>
						</page>
						
						<page string="Feuille de Facturation">
							<group string="Actes réalisés">
								<field name="bloc_fact_actes" 
									context="{'default_patient_id': patient_id}" 
									nolabel="1">
									<tree editable="bottom"
										attrs="{'readonly': [('internal_status', '=', 'done')]}">
										<field name="patient_id" />
										<field name="sex" />
										<field name="pnompatient" />
										<field name="date_realisation" />
										<field name="actes" />
										<field name="qtity" />
										<field name="categorie"/>
										<field name="infirmier"/>
										<field name="invoice_ref" />
										<field name="internal_status" />
									</tree>
								</field>
							</group>
							<group string="Médicaments donnés">
								<field name="bloc_fact_produits" 
									context="{'default_patient_id': patient_id}" 
									nolabel="1">
									<tree editable="bottom"
										attrs="{'readonly': [('internal_status', '=', 'done')]}">
										<field name="patient_id" />
										<field name="sex" />
										<field name="pnompatient" />
										<field name="date_realisation" />
										<field name="produit" />
										<field name="qtity" />
										<field name="categorie"/>
										<field name="infirmier"/>
										<field name="invoice_ref" />
										<field name="internal_status" />
									</tree>
								</field>
							</group>
							<group string="Materiels utilisés">
								<field name="bloc_fact_materiels" 
									context="{'default_patient_id': patient_id}" 
									nolabel="1">
									<tree editable="bottom"
										attrs="{'readonly': [('internal_status', '=', 'done')]}">
										<field name="patient_id" />
										<field name="sex" />
										<field name="pnompatient" />
										<field name="date_realisation" />
										<field name="produit" />
										<field name="qtity" />
										<field name="categorie"/>
										<field name="infirmier"/>
										<field name="invoice_ref" />
										<field name="internal_status" />
									</tree>
								</field>
							</group>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_blocoperatoire" model="ir.actions.act_window">
		<field name="name">Liste des Interventions</field>
		<field name="res_model">module.blocoperatoire</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field>
		<field name="context">{}</field>
	</record>

	<menuitem id="menu_blocoperatoire" sequence="99" 
				groups="fertility.group_fertility_medecin_gyneco,fertility.group_fertility_medecin,fertility.group_fertility_chefinfirmier,fertility.group_fertility_infirmier"
		name="Bloc Opératoire" />

		<menuitem id="menu_intervention_dashboard" parent="menu_blocoperatoire" 
				  action="action_blocoperatoire" sequence="1"
				  name="Dashboard" />

		<menuitem id="menu_intervention_today" parent="menu_blocoperatoire"
				  action="action_blocoperatoire" sequence="5"
				  name="Intervention du jour" />

		<!--menuitem id="menu_doctor_cfg" parent="menu_cfg_hr" groups="base.group_user" action="action_doctor_dashboard"
				  sequence="1" name="Médecins" /-->

</odoo>