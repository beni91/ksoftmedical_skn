<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<template id="report_dailybook_document">
	    <t t-call="web.external_layout">
	        <div class="page">
	        	<p>
				<h2 class="mt16" style="text-align:center !important;">
	                <span>RAPPORT DES CONSULTATIONS ROTONDE /PRIVES</span>
	            </h2>
				</p>
	            <br/>
	            <div class="oe_structure"/>
	            	<table class="table table-borderless" border="0">
	            		<tr>
							<td class="text-center">
                            <h5><span>PERIODE DU</span> <t t-esc="doc.start_date"/> <span>AU</span>   <t t-esc="doc.end_date"/></h5>
                            </td>
                        </tr>
	            	</table>
	            	<br/>
				
					<span t-raw="doc.contenu"/>
	        
	            <br/>

	            <div class="mt32 ml64 mr4" name="signature">
	                <div class="offset-8">
	                    <strong>Signature</strong>
	                </div>
	                <br/>
	                <div class="offset-8 text-center"></div>
	                <div class="offset-8">
	                    <!--span t-field="doc.doctor_id"/-->
	                </div>
	                <br/><br/><br/>
	                <div class="offset-8">
	                <p>Fait à Kinshasa, le <span t-esc="time.strftime('%Y-%m-%d %H:%M:%S')"/></p>
	                </div>
	            </div>

	            <div class="oe_structure"/>
	        </div>
	    </t>
	</template>


	<template id="report_dailybook">
	    <t t-call="web.html_container">
	        <t t-foreach="docs" t-as="doc">
	            <t t-call="ksoftmedical.report_dailybook_document"/>
	        </t>
			
	    </t>
	</template>




	<template id="report_abonne_document">
	    <t t-call="web.external_layout">
	        <div class="page">
	        	<p>
				<h2 class="mt16" style="text-align:center !important;">
	                <span>RAPPORT DES CONSULTATIONS ROTONDE /ABONNES</span>
	            </h2>
				</p>
	            <br/>
	            <div class="oe_structure"/>
	            	<table class="table table-borderless" border="0">
	            		<tr>
							<td class="text-center">
								<h5><span>CLIENT</span>: <t t-esc="doc.convention.name"/> </h5>
                            </td>
							<td class="text-center">
                            <h5><span>PERIODE DU</span> <t t-esc="doc.start_date"/> <span>AU</span>   <t t-esc="doc.end_date"/></h5>
                            </td>
                        </tr>
	            	</table>
	            	<br/>
				
					<span t-raw="doc.contenu"/>
	        
	            <br/>

	            <div class="mt32 ml64 mr4" name="signature">
	                <div class="offset-8">
	                    <strong>Signature</strong>
	                </div>
	                <br/>
	                <div class="offset-8 text-center"></div>
	                <div class="offset-8">
	                    <!--span t-field="doc.doctor_id"/-->
	                </div>
	                <br/><br/><br/>
	                <div class="offset-8">
	                <p>Fait à Kinshasa, le <span t-esc="time.strftime('%Y-%m-%d %H:%M:%S')"/></p>
	                </div>
	            </div>

	            <div class="oe_structure"/>
	        </div>
	    </t>
	</template>


	<template id="report_abonne">
	    <t t-call="web.html_container">
	        <t t-foreach="docs" t-as="doc">
	            <t t-call="ksoftmedical.report_abonne_document"/>
	        </t>
			
	    </t>
	</template>




</odoo>
