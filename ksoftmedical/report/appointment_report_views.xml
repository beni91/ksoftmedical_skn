<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<record id="action_report_appointment_labo" model="ir.actions.report">
	 	<field name="name">Bon de Laboratoire</field>
	 	<field name="model">fertility.appointment</field>
	 	<field name="report_type">qweb-pdf</field>
	 	<field name="report_name">ksoftmedical.report_appointment_labo</field>
	 	<field name="report_file">ksoftmedical.report_appointment_labo</field>
	 	<field name="print_report_name">'Laboratoire - %s' % (object.name)</field>
	 	<field name="binding_model_id" ref="model_fertility_appointment"/>
	 	<field name="binding_type">report</field>
	 	<field name="groups_id" eval="[(4, ref('group_fertility_medecin_gyneco')),
	 								   (4, ref('group_fertility_medecin'))]"/>
	</record>

