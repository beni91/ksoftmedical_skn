<odoo>

        <!-- Rapport de caisse Pharmacie  -->
    <record id="view_releve_vente_pharmacie_wizard" model="ir.ui.view">
        <field name="name">Rélevé de Vente Pharmacie</field>
        <field name="model">account.cash.report</field>
        <field name="arch" type="xml">
            <form string="Rapport Comptable">
                <sheet>
					<group string="Type de rapport">
						<field name="type_rapport" options="{'horizontal': true}" widget="radio"/>
					</group>
                    <group string="Période">
                        <group id="header_left_group">
                            <field name="start_date" required="1"/>
                            <field name="end_date_pharma" attrs="{'invisible': [('type_rapport', '=', 'periodique')]}"/>
							<field name="end_date" attrs="{'invisible': [('type_rapport', '=', 'journalier')],
															'required': [('type_rapport', '=', 'periodique')]}"/>
							
                        </group>
                        <group id="header_right_group">
                            <field name="code_jour" 
							domain="[('date_ouverture','=',start_date),('date_fermeture','=',end_date_pharma),('internal_status','=','close')]" 
							widget="selection"
							required="0"
							attrs="{'invisible': [('type_rapport', '=', 'periodique')]}"/>
							
							<field name="code_jour_ids" 
							attrs="{'invisible': [('type_rapport', '=', 'journalier')]}"
							domain="[('date_ouverture','&gt;',start_date),('date_fermeture','&lt;',end_date),('internal_status','=','close')]" 
							
							required="0" 
							/>
							
                        </group>
                    </group>
					<group  string="Conventions">
					
						<field name="convention" string="Selectionnez une convention"/>
					</group>
					
                </sheet>
                <footer>
                    <button name="pharma_convention_report_print" string="Rapport Convention PDF" type="object" class="btn-danger"/>
                    <button name="pharma_private_report_print" string="Rapport Privé PDF" type="object" class="btn-primary"/>
					<button name="pharma_convention_period_report_print" string="Rapport Périodique" type="object" 
					class="btn-success"/>
					
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>


