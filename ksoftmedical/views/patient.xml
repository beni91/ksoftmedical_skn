    <record id="view_patient_antecedent_form" model="ir.ui.view">
        <field name="name">fertility.patient.form</field>
        <field name="model">fertility.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title mb24">

                        <field name="is_company" invisible="1"/>
                        <field name="commercial_partner_id" invisible="1"/>
                        <field name="active" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <h1>
                            <field id="company" class="o_text_overflow" name="nom" default_focus="1"
                                   placeholder="Nom de la Convention..."
                                   attrs="{'required' : [('type', '=', 'contact'),('is_company', '=', True)], 'invisible': [('is_company','=', False)]}"/>
                            <field id="individual" class="o_text_overflow" name="name" default_focus="1"
                                   attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"
                                   readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field id="matricule" name="ID" attrs="{'readonly' : True}"/>

                        </div>
                    </div>

                    <notebook colspan="4">
                        <page string="Antécédents" name="antecedents" autofocus="autofocus">
                            <group string="Allergies">
                                <field name="allergie" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="date_detection"/>
                                        <field name="code"/>
                                        <field name="allergie_details" required="1"/>
                                        <field name="comment"/>
                                        <field name="etat" widget="boolean_toggle"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="ATCD">
                                <field name="atcd_medical" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="date_detection"/>
										<field name="type_atcd"/>
                                        <field name="allergie" required="1"/>
                                        
                                        <field name="comment"/>
                                        <field name="etat" widget="boolean_toggle"/>
                                    </tree>
                                </field>
                            </group>
                           
                        </page>
                    </notebook>
					<footer>
						<button name="action_save_atcd" string="Enregistrer" type="object" class="oe_highlight"/>
						<button string="Annuler" class="oe_link" special="cancel"/>
					</footer>
                </sheet>
            </form>
        </field>
    </record>


