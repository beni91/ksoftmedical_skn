			name="Dossiers en cours"
			/>
		<menuitem id="menu_pma2" parent="menu_pma" groups="group_fertility_infirmier,group_fertility_medecin_gyneco" action="action_pma_all"
			sequence="2"
			name="Toutes les dossiers"
			/-->

</odoo>