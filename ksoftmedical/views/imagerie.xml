<odoo>

	<record id="view_fertility_examen_imagerie_filter" model="ir.ui.view">
		<field name="name">fertility.examen.imagerie.search</field>
		<field name="model">fertility.examen.imagerie</field>
		<field name="arch" type="xml">
			<search string="Search Imagerie">
				<field name="date_request"/>
				<field name="patient_id"/>
				<field name="type_analyse"/>
				<field name="analyse"/>
				<separator/>

				<separator/>
				<group expand="0" string="Group By">
					<filter string="Patient" name="group_by_patient" domain="[]" context="{'group_by': 'patient_id'}"/>
					<filter string="Analyses" name="group_by_analyse" domain="[]" context="{'group_by': 'analyse'}"/>
					<filter string="Type Analyse" name="group_by_tpanalyse" domain="[]" context="{'group_by': 'type_analyse'}"/>
					<filter string="Date de demande" name="groupby_date" domain="[]" context="{'group_by': 'date_request'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="view_imagerie_tree" model="ir.ui.view">
		<field name="name">fertility.examen.imagerie.tree</field>
		<field name="model">fertility.examen.imagerie</field>
		<field name="arch" type="xml">
			<tree>
				<field name="date_request"/>
				<field name="patient_id"/>
				<field name="gender"  readonly="1"/>
				<field name="age"  readonly="1"/>
				<field name="patient_id" readonly="1"/>
				<field name="status"  widget="badge"
					decoration-danger="status=='invoicing'"
                    decoration-info="status=='protocol'"
                    decoration-success="status=='done'"
                           optional="show"/>
				<field name="type_analyse"/>
				<field name="analyse"/>
				<field name="move_id" invisible="0" string="N° Fact"/>
				<field name="move_line_id"  invisible="1"/>
				<field name="etat_facturation"/>
			</tree>
		</field>
	</record>

	<record id="view_imagerie_form" model="ir.ui.view">
		<field name="name">fertility.examen.imagerie.form</field>
		<field name="model">fertility.examen.imagerie</field>
		<field name="arch" type="xml">
			<form string="Voyage">
				<header>
					<field name="status" widget="statusbar"/>
					<button name="action_done" class="oe_highlight" type="object" attrs="{'invisible': [('status', '!=', 'ongoing')]}" string="Valider" />
					<button name="action_protocol_done" class="oe_highlight" type="object" attrs="{'invisible': [('status', '!=', 'protocol')]}" string="Valider" />
				</header>
				<sheet>
					<div>
						<h1 class="mt0">
							<field name="imagerie_name"  readonly="1"/>
						</h1>

					</div>
					<group string="Patient">
						<field name="patient_id"  readonly="1"/>
						<field name="parent_id"  string="Convention" readonly="1"/>
						<field name="gender"  readonly="1"/>
						<field name="age"  readonly="1"/>
					</group>
					<group string="Examen Imagerie">
						<field name="date_request"  readonly="1"/>
						<field name="type_analyse" readonly="1" />
						<field name="analyse" readonly="1"/>
						<field name="clinique" readonly="1"/>
						<field name="demandeur" readonly="1"/>
					</group>
					<group string="Protocole" attrs="{'invisible': [('status', '=', 'invoicing')]}">
						<group>
							<field name="date_analyse" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}"  string="Date de validation:"/>
							<field name="technicien" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}" string="Valider par:"/>
							
						</group>

						<group>
						<label for="url_clicher"/>
							<field name="url_clicher" nolabel="1" attrs="{'readonly': [('status', 'not in', ['protocol'])]}" 
							widget ="url" cols="2"/>
						</group>
					</group>
					<group attrs="{'invisible': [('status', '=', 'invoicing')]}">
					<label for="protocol"/>
						<field name="protocol" widget="html" nolabel="1" attrs="{'readonly': [('status', 'not in', ['protocol'])]}"
							placeholder="Saisir le protocole d'imagerie ici"/>
						
					</group>

				</sheet>
			</form>
		</field>
	</record>

	<record id="view_resultimagerie_tree" model="ir.ui.view">
		<field name="name">fertility.examen.imagerie.tree</field>
		<field name="model">fertility.examen.imagerie</field>
		<field name="arch" type="xml">
			<tree create="false" edit="false">
				<field name="date_request"/>
				<field name="date_analyse"  string="D. Resultat"/>
				<field name="patient_id" invisible="0"/>
				<field name="gender" invisible="0"/>
				
				<field name="age" invisible="0"/>
				<field name="parent_id" invisible="0"/>
				<field name="type_analyse" invisible="1"/>
				<field name="analyse"/>
				<field name="protocol" widget="html"/>
				<field name="status"  widget="badge"
					decoration-danger="status=='invoicing'"
                    decoration-info="status=='protocol'"
                    decoration-success="status=='done'"
                           optional="show"/>
			</tree>
		</field>
	</record>
	
	<record id="view_out_invoice_tree_imagerie" model="ir.ui.view">
            <field name="name">account.out.invoice.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <!--field name="mode">primary</field-->
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                </xpath>
            </field>
        </record>
	
	<!-- Voir les factures de laboratoire -->
		<record id="action_imagerie_invoice_today" model="ir.actions.act_window">
            <field name="name">Mes factures</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_out_invoice_tree_imagerie"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('libelle', '=', 'imagerie'),('invoice_date_due','=',context_today())]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Créer une facture
              </p><p>
                Factures des examens imageries
              </p>
            </field>
        </record>
		
		<record id="action_imagerie_invoice_all" model="ir.actions.act_window">
            <field name="name">Mes factures</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_out_invoice_tree_imagerie"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('libelle', '=', 'imagerie')]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Créer une facture
              </p><p>
                Factures des examens laboratoires
              </p>
            </field>
        </record>

