	<menuitem id="menu_config" sequence="500" groups="ksoftmedical.group_ksoft_admin"
		name="Configuration"  web_icon="ksoftmedical,static/description/config_icon.png"/>

		<menuitem id="menu_cfg_hr" parent="menu_config" groups="ksoftmedical.group_ksoft_admin" sequence="1"
			name="Resources humaines" />

			<menuitem id="menu_speciality_cfg" parent="menu_cfg_hr" groups="ksoftmedical.group_ksoft_admin" 
				action="action_speciality"
				sequence="1"
				name="Spécialité médicale" />

			<menuitem id="menu_doctor_cfg" parent="menu_cfg_hr" groups="ksoftmedical.group_ksoft_admin" action="action_doctor_dashboard"
				sequence="2"
				name="Médecins" />


		<menuitem id="menu_cfg_services" parent="menu_config" groups="ksoftmedical.group_ksoft_admin" sequence="2"
			name="Services" />

			<menuitem id="menu_services_cfg" parent="menu_cfg_services" groups="ksoftmedical.group_ksoft_admin" 
				action="action_services"
				sequence="1"
				name="Services" />
				
			<menuitem id="menu_krubriques_cfg" parent="menu_cfg_services" groups="ksoftmedical.group_ksoft_admin" 
				action="action_ksoftrubriques"
				sequence="1"
				name="Rubriques" />

			

		<menuitem id="menu_cfg_unitesoins" parent="menu_config" groups="ksoftmedical.group_ksoft_admin" sequence="2"
			name="Unité de soins" />

			<menuitem id="menu_unite_cfg" parent="menu_cfg_unitesoins" groups="ksoftmedical.group_ksoft_admin" 
				action="action_unite"
				sequence="1"
				name="Unité de soins" />
				
		<menuitem id="menu_cfg_chambre" parent="menu_config" groups="ksoftmedical.group_ksoft_admin" sequence="5"
			name="Hotéllerie" />

			<menuitem id="menu_unite_chambre" parent="menu_cfg_chambre" groups="ksoftmedical.group_ksoft_admin" 
				action="action_chambre"
				sequence="1"
				name="Hotellerie" />

			



</odoo>