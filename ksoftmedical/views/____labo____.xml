<odoo>

	<record id="view_labo_tree" model="ir.ui.view">
		<field name="name">fertility.examen.labo.tree</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<tree create="false" decoration-danger="is_pathologique=='True'">
				<field name="date_request"/>
				<field name="echantillon_num"/>
				<field name="patient_id"/>
				<field name="gender"  readonly="1"/>
				<field name="age"  readonly="1"/>
				<field name="status" widget="badge"
                    decoration-danger="status=='invoicing'"
                    decoration-info="status=='sample'"
                    decoration-success="status=='done'"
                           optional="show"/>
				<field name="type_analyse"/>
				<field name="analyse"/>
				<field name="is_pathologique"/>
				<field name="medecin_demander"/>
				<field name="move_id"  invisible="0" string="N° Fact"/>
				<field name="move_line_id"  invisible="1"/>
				<field name="etat_facturation"/>
			</tree>
		</field>
	</record>

	<record id="view_labo_form" model="ir.ui.view">
		<field name="name">fertility.examen.labo.form</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<form string="Voyage" create="false">
				<header>
					<field name="status" widget="statusbar"/>
					<button name="action_sample_done" class="oe_highlight" type="object" 
						attrs="{'invisible': [('status', '!=', 'sample')]}" string="Valider" />
					<button name="action_done" class="oe_highlight" type="object" attrs="{'invisible': [('status', '!=', 'ongoing')]}" string="Valider" />
				</header>
				<sheet>
					<div>
						<h1 class="mt0">
							<field name="labo_name"  readonly="1"/>							
						</h1>
					</div>
					<group>
						<group string="Patient">
							<field name="patient_id"  readonly="1"/>
							<field name="parent_id"  string="Convention" invisible="1"/>
							<field name="gender"  readonly="1"/>
							<field name="age"  readonly="1"/>
							
						</group>
						<group string="Prélèvement">			
							<!--field name="echantillon_num" attrs="{'readonly': [('status', '!=', 'sample')]}"/-->
							<field name="date_prelevement" readonly="1"/>
							<field name="technicien_prelevement" readonly="1"/>
							<!--field name="echantillon" widget="many2manyattendee"  attrs="{'readonly': [('status', '!=', 'sample')]}"/-->
						</group>
					</group>
					<group string="Examen Laboratoire" attrs="{'invisible': [('status', 'not in', ['sample','ongoing','done'])]}">	
						<field name="date_request"  readonly="1"/>
						<field name="type_analyse" readonly="1" />
						<field name="medecin_demander" readonly="1"/>
						<field name="analyse" readonly="1" />	
						<field name="clinique" readonly="1"/>
					</group>
					<group string="Examen Laboratoire" attrs="{'invisible': [('status', 'not in', ['ongoing','done'])]}">
						<field name="date_analyse" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}"  string="Date de validation:"/>					
						<field name="technicien" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}" string="Valider par:"/>
						<field name="description" attrs="{'readonly': [('status', '!=', 'ongoing')]}"/>
						<field name="is_pathologique"/>
						<field name="valeur_normale" readonly="1"/>
					</group>					
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_resultlabo_tree" model="ir.ui.view">
		<field name="name">fertility.examen.labo.tree</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<tree create="false" edit="false">
				<field name="date_request"/>
				<field name="date_analyse" string="D. validation:"/>	
				<field name="patient_id" invisible="1"/>
				<field name="gender" readonly="1" invisible="1"/>
				<field name="age" readonly="1" invisible="1"/>
				<field name="type_analyse" invisible="1"/>
				<field name="analyse"/>
				<field name="description" />
				<field name="valeur_normale" />
				<field name="medecin_demander"/>
				<field name="move_id"/>
				<field name="move_line_id"/>
				<field name="status" widget="badge"
                    decoration-danger="status=='invoicing'"
                    decoration-info="status=='sample'"
                    decoration-success="status=='done'"
                           optional="show"/>
			</tree>
		</field>
	</record>

	<!-- Voir tous les resultats -->
	<record id="action_resultatlabo_all" model="ir.actions.act_window">
		<field name="name">Tableau synthétique des Resultats Laboratoires</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_id" ref="ksoftmedical.view_resultlabo_tree"/>
		<field name="view_mode">tree</field>
		<field name="domain">[('internal_status','=','done')]</field>
	</record>


	<record id="action_labo_all" model="ir.actions.act_window">
		<field name="name">Toutes les examens</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[]</field> 
	</record>
	<record id="action_labo_today" model="ir.actions.act_window">
		<field name="name">Prévu aujourd'hui</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('date_request','=',context_today())]</field> 
	</record>
	
	<!-- Menu Prelevement jour -->
	<record id="action_prelevement_today" model="ir.actions.act_window">
		<field name="name">Prévu aujourd'hui</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','in',['sample','invoicing']),('date_request','=',context_today())]</field> 
	</record>
	
	<!-- Menu Prelevement All -->
	<record id="action_prelevement_all" model="ir.actions.act_window">
		<field name="name">Prélèvements</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','in',['sample','invoicing'])]</field> 
	</record>
	
	<!-- Menu Encodage resultat du jour -->
	<record id="action_encodage_today" model="ir.actions.act_window">
		<field name="name">Prévu aujourd'hui</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','=','ongoing'),('date_request','=',context_today())]</field> 
	</record>
	
	<!-- Menu Encodage resultat All -->
	<record id="action_encodage_all" model="ir.actions.act_window">
		<field name="name">Prélèvements</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','=','ongoing'),]</field> 
	</record>
	
	<!-- Menu resultat du jour -->
	<record id="action_resultat_today" model="ir.actions.act_window">
		<field name="name">Prévu aujourd'hui</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','=','done'),('date_request','=',context_today())]</field> 
	</record>
	
	<!-- Menu resultat All -->
	<record id="action_resultat_all" model="ir.actions.act_window">
		<field name="name">Prélèvements</field>
		<field name="res_model">fertility.examen.labo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('internal_status','=','done')]</field> 
	</record>

	<menuitem id="menu_labo" parent="menu_consult" groups="group_fertility_reception"
		sequence="3"
		name="Laboratoire"
		/>
		<menuitem id="menu_labo1" parent="menu_labo" groups="group_fertility_reception" action="action_labo_today"
			sequence="1"
			name="Prévu aujourd'hui"
			/>
		<menuitem id="menu_labo2" parent="menu_labo" groups="group_fertility_reception" action="action_labo_all"
			sequence="2"
			name="Tous les examens"
			/>
			
	
	<!-- Menu Laboratoire -->
	<menuitem id="menu_laboratoire"  groups="group_fertility_laboratoire"
		sequence="20"
		name="Laboratoire"  web_icon="ksoftmedical,static/description/labo/icon.png"
		/>
		
		<!-- Menu Prelevement -->
		<menuitem id="menu_labo_prelevement" parent="menu_laboratoire"  groups="group_fertility_laboratoire"
		sequence="1"
		name="Prélèvement"
		/>
			<menuitem id="menu_labo_prelevement1" parent="menu_labo_prelevement"  groups="group_fertility_laboratoire"
			sequence="1"
			action="action_prelevement_today"
			name="Prélèvement du jour"
			/>
			
			<menuitem id="menu_labo_prelevement2" parent="menu_labo_prelevement"  groups="group_fertility_laboratoire"
			sequence="2"
			action="action_prelevement_all"
			name="Prélèvements"
			/>
			
		
		<!-- Menu Resultat a inscrire -->
		<menuitem id="menu_labo_inscription" parent="menu_laboratoire"  groups="group_fertility_laboratoire"
		sequence="1"
		name="Encodage Resultat"
		/>
			<menuitem id="menu_labo_inscription1" parent="menu_labo_inscription"  groups="group_fertility_laboratoire"
			sequence="1"
			action="action_encodage_today"
			name="Encodage du jour"
			/>
			
			<menuitem id="menu_labo_inscription2" parent="menu_labo_inscription"  groups="group_fertility_laboratoire"
			sequence="2"
			action="action_encodage_all"
			name="Encodage"
			/>
			
			
		<!-- Menu Resultat inscrit -->
		<menuitem id="menu_labo_resultat" parent="menu_laboratoire"  groups="group_fertility_laboratoire"
		sequence="1"
		name="Resultats validés"
		/>
			<menuitem id="menu_labo_resultat1" parent="menu_labo_resultat"  groups="group_fertility_laboratoire"
			sequence="1"
			action="action_resultat_today"
			name="Resultat du jour"
			/>
			
			<menuitem id="menu_labo_resultat2" parent="menu_labo_resultat"  groups="group_fertility_laboratoire"
			sequence="2"
			action="action_resultat_all"
			name="Resultats"
			/>
			
		<!-- Menu Laboratoire parametre -->
		<menuitem id="menu_labo_parametres" parent="menu_laboratoire"  groups="group_fertility_laboratoire"
		sequence="1"
		name="Impression des resultats"
		/>

			<menuitem id="menu_result_labo2" parent="menu_labo_impression"  groups="group_fertility_laboratoire"
			sequence="2"
			action="action_resultat_all"
			name="Resultats"
			/>
		
		
	


</odoo>