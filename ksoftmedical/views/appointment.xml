<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_appointment_patient_form" model="ir.ui.view">
        <field name="name">ksoft.appointment.form</field>
        <field name="model">ksoft.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="internal_status" widget="statusbar" statusbar_visible="home,valid"/>
                    <button name="action_create" class="oe_highlight" type="object"
                            attrs="{'invisible': ['|',('internal_status', '!=', 'home'),('is_followUp','=',True)]}"
                            string="Confirmer"/>

                    <!--button name="shop" class="oe_highlight" type="object"
                            attrs="{'invisible': ['|',('internal_status', '!=', 'home'),('is_followUp','=',True)]}"
                            string="SHOP"/>					
					
                    <button name="action_create_woutinvoice" class="oe_highlight" type="object"
                            attrs="{'invisible': ['|',('internal_status', '!=', 'home'),('is_followUp','=',True)]}"
                            string="Confirmer sans payer"/-->

                    <button name="action_return" class="oe_highlight" type="object"
                            attrs="{'invisible':['|',('internal_status',  'not in', ['home','invoicing']),('etat','=','annul'),('is_followUp','=',True)]}"
                            string="Annuler"/>

                    <button name="%(action_annuler_rdv)d" class="oe_highlight" type="action"
                            string="Supprimer RDV"
                            attrs="{'invisible':['|',('etat','=','annul'),('is_followUp','=',True)]}"/>

                    <button name="action_pass_rdv_to_immed" class="oe_highlight" type="object"
                            attrs="{'invisible':[('time_rdv','!=','rdv')]}"
                            string="Envoyer au triage"/>

                    <button name="add_to_appoint" class="oe_highlight" type="object"
                            attrs="{'invisible':[('is_followUp','=',False)]}"
                            string="Ajouter aux RDV"/>

                </header>
                <sheet>
					<div style="float:left !important;">
                         <button name="change_statut" class="oe_highlight" type="object"
                            attrs="{'invisible': [('internal_status', '=', 'home')]}" string="Actualiser le statut"/>
                    </div>
                    <div name="button_box" class="oe_button_box">
                        <button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_partner_consult_invoices"
                            context="{'default_partner_id': active_id}"
                            attrs="{'invisible':[('internal_status','=','home')]}">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_invoiced" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Factures</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button string="Voir les rdv de ce jours" type="action"
                                name="%(action_wizard_day_reservation)d"
                                class="oe_stat_button" icon="fa-address-card"  attrs="{'invisible':[('is_followUp','=',False)]}"/>
                    </div>
                    <widget name="web_ribbon" title="Annulé" bg_color="bg-danger"
                            attrs="{'invisible':[('etat','!=','annul')]}"/>
                    <!--div>
                        <h3 class="mt0">
                            <div>
                                <label string="Patient" for="patient_id"/>
                                <field name="patient_id" required="1"
                                       attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            </div>
                            <div>
                                <label string="Visiteur" for="visitor"/>
                                <field name="visitor" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            </div>
                        </h3>
                    </div-->
                    <group>
                        <group id="header_left_group" string="IDENTIFICATION DU PATIENT">
                            <field name="patient_id" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <field name="age" readonly="1"/>
                            <field name="gender" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="function" readonly="1"/>

                            <field name="categorie" readonly="1"
                                   attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <field name="convention_id" string="Convention"
                                   attrs="{'readonly':[('internal_status','!=','home')], 'invisible':[('categorie','!=','convention')]}"/>
                            <field name="classe" readonly="1" attrs="{'invisible':[('categorie','!=','convention')]}"/>
                            <field name="matricule" readonly="1"
                                   attrs="{'invisible':[('categorie','!=','convention')]}"/>
                            <field name="numero_billet"/>
                            <field name="etat" invisible="1"/>
                        </group>
                        <group id="header_right_group" string="Informations sur le rdv">
							<field name="type_transfert" />
							<field name="origine_patient" attrs="{'invisible': [('type_transfert', '!=','avcdoc')]}"/>
							<field name="nom_centre" attrs="{'invisible': [('origine_patient', '=','centre'),('type_transfert', '!=','avcdoc')]}"/>
                            <field name="time_rdv" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <field name="title" invisible="1" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <field name="date_rdv" required="1" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <!--field name="heure_rdv"/-->
                            <field name="service" attrs="{'readonly':[('internal_status','!=','home')]}"
                                   domain="[('type_rdv','in',['cons','urg'])]" options="{'no_create': True,'no_create_edit': True}"/>
                            <field name="type_rdv" invisible="0"/>
                            <!--field name="service_consultation" string="Pavillon" attrs="{'required':[('type_rdv','in',['cons', 'chi'])],
										'readonly':[('internal_status','!=','home')]}"/-->
                            <field name="product_id"
                                   attrs="{'required':[('type_rdv','=','cons')],'readonly':[('internal_status','!=','home')]}"
                                   domain="[('is_consultation','=',True)]" 
								   options="{'no_create': True,'no_create_edit': True}" string="Type de consultation"/>
                            <!--field name="product_id2"
                                   attrs="{'required':[('type_rdv','=','chi')],'readonly':[('internal_status','!=','home')]}"
                                   domain="[('is_chirurgie','=',True)]"/-->
                            <field name="medecin" options="{'no_create': True,'no_create_edit': True}"
							attrs="{'required':[('type_rdv','in',['cons', 'chi'])],'readonly':[('internal_status','!=','home')]}"/>
                            <field name="speciality" readonly="1"/>
                            <field name="motif" attrs="{'readonly':[('internal_status','!=','home')]}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="type_patient" required="True"/>

                            <field name="motannul" attrs="{'invisible':[('etat','!=','annul')]}"/>
                            <field name="date_conf" attrs="{'invisible':[('internal_status','=','home')]}"
                                   readonly="1"/>
                            <field name="time_since_conf" attrs="{'invisible':[('internal_status','=','home')]}"/>
                            <field name="date_recorded" readonly="1" string="Date d'enregistrement"/>
                            <field name="is_followUp" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appointment_patient_tree" model="ir.ui.view">
        <field name="name">ksoft.appointment.form</field>
        <field name="model">ksoft.appointment</field>
        <field name="arch" type="xml">
            <tree decoration-success="internal_status=='invoicing'"
                  decoration-info="internal_status=='home'"
                  decoration-muted="internal_status=='closed'"
                  decoration-danger="etat=='annul'">

                <field name="date_rdv"/>
                <field name="time_rdv"/>
                <field name="patient_id"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="categorie" readonly="1"/>
                <field name="convention_id" string="Convention"/>
                <!--field name="type_rdv" invisible="1"/>
                <field name="motif" invisible="1"/>
                <field name="product_id" invisible="1"/-->
                <field name="medecin"/>
                <field name="etat" invisible="1"/>
                <field name="ref_moved"/>
                <field name="internal_status" string="Etat Rdv"/>
                <field name="status_moved" string="Etat Facture"/>
                <field name="status_consultation" string="Etat Consult."/>
            </tree>
        </field>
    </record>

    <record id="view_appointment_patient_calendar" model="ir.ui.view">
        <field name="name">ksoft.appointment.calendar</field>
        <field name="model">ksoft.appointment</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <calendar string="Rendez-vous" date_start="date_rdv"
                      event_open_popup="true" mode="week"
                      quick_add="false" event_limit="5" color="medecin">
                <!--attrs="{'create': [('status', 'in', ['open','closed'])]}"-->
                <field name="patient_id"/>
                <field name="medecin" filters="1"/>
                <field name="date_rdv"/>
                <field name="service" filters="1"/>
                <field name="internal_status" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="appointment_patient_followUp_kanban" model="ir.ui.view">
        <field name="name">appointement.followup.kanban</field>
        <field name="model">ksoft.appointment</field>
        <field name="arch" type="xml">
            <kanban create="0">
                <field name="patient_id"/>
                <field name="medecin"/>
                <field name="date_rdv"/>
                <field name="is_followUp"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li>
                                        <field name="patient_id"/>
                                    </li>
                                    <li>
                                        <field name="medecin"/>
                                    </li>
                                    <li>
                                        <field name="date_rdv"/>
                                    </li>
                                    <li>
                                        <field name="is_followUp"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_appointment_patient_search" model="ir.ui.view">
        <field name="name">ksoft.appointment.search</field>
        <field name="model">ksoft.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Rendez-vous">
                <field name="title"/>
                <field name="date_rdv"/>
                <field name="type_rdv"/>
                <field name="medecin"/>
                <field name="motif"/>
                <field name="user_id"/>
                <field name="nom"/>
                <field name="prenom"/>
                <field name="postnom"/>
                <field name="gender"/>
                <field name="categorie"/>
                <field name="internal_status"/>
                <field name="convention_id"/>

                <filter name="filter_categorie" string="Privés" domain="[('categorie','=','prive')]"/> <!--Ici on a crée un filtre-->

                <!--group string="Group By"-->
                    <!--filter string="Genre" name="group_by_gender" context="{'group_by':'gender'}"/--> <!--Ici on a crée un group by-->
                <!--/group-->
                <group string="Group By">
                    <filter string="Date de RDV" name="group_by_DateRDV" context="{'group_by':'date_rdv'}"/>
               
                    <filter string="Etat du RDV" name="group_by_EtatRDV" context="{'group_by':'internal_status'}"/>
                
               
					<filter string="Patient" name="group_by_Patient" context="{'group_by':'patient_id'}"/>
					<filter string="Médecin" name="group_by_eMeecin" context="{'group_by':'medecin'}"/>
					<filter string="Convention" name="group_by_Convention" context="{'group_by':'convention_id'}"/>
					<filter string="Type de cas" name="group_by_Cas" context="{'group_by':'type_patient'}"/>
					<filter string="Type de consultation" name="group_by_tcons" context="{'group_by':'product_id'}"/>
					<filter string="Zone" name="group_by_zone" context="{'group_by':'zone'}"/>
					<filter string="Type transfert" name="group_by_transfert" context="{'group_by':'type_transfert'}"/>
					<filter string="Origine patient" name="group_by_origine" context="{'group_by':'origine_patient'}"/>
				</group>
            </search>
        </field>
    </record>

    <record id="action_appointment_patient" model="ir.actions.act_window">
        <field name="name">Tous les Rdv</field>
        <field name="res_model">ksoft.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_followUp','=',False)]</field>
        <!--field name="view_id" ref="view_appointment_patient_calendar"/-->
        <field name="search_view_id" ref="view_appointment_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de rendez-vous
            </p>
            <p>

            </p>
        </field>
    </record>

    <record id="action_todayappointment_patient" model="ir.actions.act_window">
        <field name="name">Rdv du jour</field>
        <field name="res_model">ksoft.appointment</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="domain">[('date_rdv','&lt;=',context_today().strftime('%Y-%m-%d 23:59:59')),('date_rdv','&gt;',context_today().strftime('%Y-%m-%d 00:00:00')),('is_followUp','=',False)]</field>
        <field name="view_id" ref="view_appointment_patient_tree"/>
        <field name="search_view_id" ref="view_appointment_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de rendez-vous
            </p>
            <p>

            </p>
        </field>
    </record>
    
    <record id="action_nextappointment_patient" model="ir.actions.act_window">
        <field name="name">Prochain Rdv</field>
        <field name="res_model">ksoft.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('date_rdv','&gt;',context_today().strftime('%Y-%m-%d')),('is_followUp','=',False)]</field>
        <!--field name="view_id" ref="view_appointment_patient_calendar"/-->
        <field name="search_view_id" ref="view_appointment_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de rendez-vous
            </p>
        </field>
    </record>

    <record id="action_appointment_patient_follow_up" model="ir.actions.act_window">
        <field name="name">Rdv_FollowUp</field>
        <field name="res_model">ksoft.appointment</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('is_followUp','=',True)]</field>
        <!--field name="view_id" ref="view_appointment_patient_calendar"/-->
        <field name="search_view_id" ref="view_appointment_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de Follow up
            </p>
        </field>
    </record>

    <record id="action_view_appointment_patient_calendar" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_appointment_patient"/>
        <field name="sequence" eval="2"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_appointment_patient_calendar"/>
    </record>

    <record id="action_view_appointment_patient_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_appointment_patient"/>
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_appointment_patient_tree"/>
    </record>

    <record id="action_view_appointment_patient_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_appointment_patient"/>
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_appointment_patient_form"/>
    </record>


</odoo>