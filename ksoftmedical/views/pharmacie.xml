<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacie_tree" model="ir.ui.view">
        <field name="name">module.pharmacie.tree</field>
        <field name="model">module.ordonnance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_ordonnance"/>
                 <field name="client"/>
                <field name="patient_id"  invisible="0"/>
				<field name="client_name" string="Nom du patient"/>
                <field name="age" optional="0" invisible="0"/>
                <field name="sex" invisible="0"/>
                <field name="poids" string="Poids" optional="0" invisible="0"/>
                <field name="parent_id2"/>
                <field name="categorie2" invisible="0"/>
                <field name="medecin"/>
                <field name="move_id" string="N° Facture"/>
                <field name="internal_status"
                    widget="badge"
                    decoration-danger="internal_status=='invoicing'"
                    decoration-info="internal_status=='draft'"
                    decoration-warning="internal_status=='partiel'"
                    decoration-success="internal_status=='delivered'"
                     optional="show"/>
                <field name="status_moved"/>
                <field name="status" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_pharmacie_form" model="ir.ui.view">
        <field name="name">module.pharmacie.form</field>
        <field name="model">module.ordonnance</field>
        <field name="arch" type="xml">
            <form string="Prescription Médicale">
                <header>
                    <field name="internal_status" widget="statusbar"
                           statusbar_visible="draft,invoicing,pret,delivered,canced"/>
                    <button name="action_autoriser" class="oe_highlight" type="object"
                            attrs="{'invisible': [('internal_status', '!=', 'draft')]}" string="Autoriser"/>

                    <!--button name="action_partielle_livraison" class="oe_highlight" type="object"
                        attrs="{'invisible': [('internal_status', 'not in', ['pret','partiel'])]}"
                        string="Livraison partielle" />

                    <button name="action_complete_livraison" class="oe_highlight" type="object"
                        attrs="{'invisible': [('internal_status', 'not in', ['pret','partiel'])]}"
                        string="Livraison totale" /-->

                    <button name="action_cancel" class="oe_highlight" type="object"
                            attrs="{'invisible': [('internal_status', '=', 'cancel')]}" 
							groups="ksoftmedical.group_fertility_pharmacie_chef"
							string="Annuler"/>
                </header>
                <sheet>
                    <div style="float:left !important;">
                         <button name="change_statut" class="oe_highlight" type="object"
                            attrs="{'invisible': [('internal_status', 'in', ['draft','delivered'])]}" string="Actualiser le statut"/>
                    </div>
                    <div name="button_box" class="oe_button_box">
                        <button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_partner_invoices"
                            context="{'default_partner_id': active_id}"
                            attrs="{'invisible':[('internal_status','=','draft')]}">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_invoiced" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Factures</span>
                            </div>
                        </button>
                    </div>
                    <group string="Info Patient">
                        <group>
                            <field name="client" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"
							invisible="1"/>
                            <field name="patient_id" readonly="0" options="{'no_create':True, 'no_create_edit':True}"/>
							<field name="client_name" string="Nom du patient" placeholder="Saisir le nom du patient"
							attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                            <field name="sex" invisible="0"/>
                            <field name="age" invisible="0"/>
                            <separator string="Info professionnelles"/>
							<field name="categorie2" readonly="1" force_save="1" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                            <field name="parent_id2" string="Convention"
							readonly="1" force_save="1"/>
                            <field name="matricule" readonly="1" force_save="1"/>
                            <field name="classe" readonly="1" force_save="1"/>
                            <field name="numero_billet" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                        </group>
                        <group>
							<field name="code_session" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                            <field name="date_ordonnance" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                            <field name="medecin" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                            <separator string="Info de facturation"/>
                            <field name="move_id" string="N° Facture" readonly="1"
                                   attrs="{'invisible': [('internal_status', 'not in', ['invoicing','pret','delivered'])]}"/>
                            <field name="status_moved" readonly="1"/>
                            <separator string="Info de Stock"/>
                            <field name="service_id" readonly="0" required="1" attrs="{'readonly': [('internal_status', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <group string="Produits">
                        <field name="produit_ids"
                               context="{'default_patient_id': patient_id}" nolabel="1" attrs="{'readonly': [('internal_status', '!=', 'draft')]}">
                            <tree editable="bottom">
                                <field name="is_print" string="#"/>
                                <field name="patient_id" readonly="1" invisible="1"/>
                                <field name="date_ordonnance" readonly="1"/>
                                <field name="product"
                                       widget="Many2one" required="1"
                                       domain="[('is_medicaments','=',True)]"/>
                                <field name="product_uom" invisible="1"/>
                                <field name="product_name" invisible="0"/>
                                <field name="px" invisible="1"/>
                                <field name="posologie" readonly="0"/>
                                <!-- <field name="internal_status" readonly="1" string="Livraison" 
                                    widget="badge"
                                    decoration-danger="internal_status=='invoicing'"
                                    decoration-info="internal_status=='draft'"
                                    decoration-warning="internal_status=='partiel'"
                                    decoration-success="internal_status=='delivered'"
                                        optional="show"/-->
                                <!-- <field name="qtity_stock" string="En Stock"/> -->
                                <field name="quantity" readonly="1" string="Q. Dem."/>
                                <field name="quantity2" required="1" string="Q. Livrée."/>
                                <field name="qtity_stock" readonly="0" string="Q. en Stock."/>
								<field name="medecin_id" invisible="1"/>
                                <field name="price_unit" invisible="1"/>
                                <field name="is_modify" invisible="1"/>
                                <field name="note" invisible="1"/>
                                <field name="numero_billet" invisible="1"/>
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="commentaire_medecin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Ordonnances non autorisées -->
    <record id="action_pharmacie_not_invoiced_today" model="ir.actions.act_window">
