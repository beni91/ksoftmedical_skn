    <record id="action_parmacie_today" model="ir.actions.act_window">
        <field name="name">Prévu aujourd'hui</field>
        <field name="res_model">module.ordonnance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_status','!=','draft'),('date_ordonnance','=',context_today())]</field>
    </record>

    <record id="view_module_ordonnance_search" model="ir.ui.view">
		<field name="name">module.ordonnance.search</field>
		<field name="model">module.ordonnance</field>
		<field name="arch" type="xml">
			<search string="Patient">
				<field name="patient_id"/>
			</search>
		</field>
	</record>
	
	
	<!-- Factures individuelles -->
	<record id="action_my_invoice" model="ir.actions.act_window">
        <field name="name">Mes factures</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[()]</field>
    </record>
	
	<record id="action_service_custom" model="ir.actions.act_window">
        <field name="name">Stock Service</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <!--field name="context">{'default_is_company': True}</field-->
        <field name="domain">[('srvice_stock','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un service de destination stock  
            </p>
            <p>
           
            </p>
        </field>
    </record>
	
	<record id="action_my_invoice_form_view" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="account.view_move_form"/>
            <field name="act_window_id" ref="action_my_invoice"/>
        </record>
        <record id="action_my_invoice_tree_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="account.view_out_invoice_tree"/>
            <field name="act_window_id" ref="action_my_invoice"/>
        </record>
		
	
	<record id="view_out_invoice_tree_pharmacie" model="ir.ui.view">
            <field name="name">account.out.invoice.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <!--field name="mode">primary</field-->
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                </xpath>
            </field>
        </record>
	
	<!-- Voir les factures de laboratoire -->
		<record id="action_pharmacie_invoice_today" model="ir.actions.act_window">
            <field name="name">Mes factures</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_out_invoice_tree_pharmacie"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('libelle', '=', 'pharmacie'),('invoice_date_due','=',context_today())]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Créer une facture
              </p><p>
                Factures des examens pharmacie
              </p>
            </field>
        </record>
		
		<record id="action_pharmacie_invoice_all" model="ir.actions.act_window">
            <field name="name">Mes factures</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_out_invoice_tree_pharmacie"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('libelle', '=', 'pharmacie')]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Créer une facture
              </p><p>
                Factures des examens laboratoires
              </p>
            </field>
        </record>


