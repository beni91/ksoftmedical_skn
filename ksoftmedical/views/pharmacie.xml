    </record>

    <record id="action_pharmacie_all" model="ir.actions.act_window">
        <field name="name">Toutes les prescriptions</field>
        <field name="res_model">module.ordonnance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_status','!=','draft')]</field>
