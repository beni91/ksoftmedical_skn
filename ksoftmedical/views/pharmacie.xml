        <field name="view_mode">tree,form</field>
        <field name="domain">[('internal_status','in',['draft','invoicing']),('date_ordonnance','=',context_today())]</field>
    </record>
    <record id="action_pharmacie_not_invoiced_all" model="ir.actions.act_window">
