<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_doctor_tree" model="ir.ui.view">
		<field name="name">fertility.doctor.tree</field>
		<field name="model">fertility.doctor</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name" />
				<field name="speciality_id" />
			</tree>
		</field>
	</record>

	<record id="view_doctor_form" model="ir.ui.view">
		<field name="name">fertility.doctor.form</field>
		<field name="model">fertility.doctor</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" /></h1>
					</div>
					<group>
						<field name="user_id" />
						<field name="speciality_id" />
						<field name="service_id" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_doctor_dashboard" model="ir.actions.act_window">
		<field name="name">Médecin</field>
		<field name="res_model">fertility.doctor</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>



</odoo>