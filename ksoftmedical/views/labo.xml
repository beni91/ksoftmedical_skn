<odoo>

	<record id="view_labo_tree" model="ir.ui.view">
		<field name="name">fertility.examen.labo.tree</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<tree create="false" decoration-danger="is_pathologique=='True'">
				<field name="date_request"/>
				<field name="echantillon_num"/>
				<!--field name="partner_id" string="client"/>
				<field name="client_nom"/-->
				<field name="patient_id"/>
				<field name="gender"  readonly="1"/>
				<field name="age"  readonly="1"/>
				<field name="categorie"  readonly="1"/>
				<field name="parent_id"  string="Convention" invisible="0"/>
				<field name="classe"  readonly="1"/>
				<field name="numero_billet"  readonly="0"/>
				<field name="status" widget="badge"
                    decoration-danger="status=='invoicing'"
                    decoration-info="status=='sample'"
                    decoration-success="status=='done'"
                           optional="show"/>
				<field name="type_analyse"/>
				<field name="analyse"/>
				<field name="is_pathologique" invisible="1"/>
				<field name="medecin_demander"/>
				<field name="move_id"  invisible="0" string="N° Fact"/>
				<field name="move_line_id"  invisible="1"/>
				<field name="etat_facturation"/>
			</tree>
		</field>
	</record>
	
	<record id="view_labo_tree_resultats" model="ir.ui.view">
		<field name="name">fertility.labo.resultat.tree</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<tree create="false" edit="false" decoration-danger="is_pathologique=='True'">
				<field name="date_request"/>
				<field name="date_analyse"/>
				<!--field name="echantillon_num"/>
				<field name="partner_id" string="client"/>
				<field name="client_nom"/-->
				<field name="patient_id"/>
				<field name="gender"  readonly="1"/>
				<field name="age"  readonly="1"/>
				<field name="categorie"  readonly="1"/>
				<field name="parent_id"  string="Convention" invisible="0"/>
				<!--field name="classe"  readonly="1"/>
				<field name="numero_billet"  readonly="1"/>
				<field name="status" widget="badge"
                    decoration-danger="status=='invoicing'"
                    decoration-info="status=='sample'"
                    decoration-success="status=='done'"
                           optional="show"/-->
				<field name="type_analyse"/>
				<field name="analyse"/>
				<field name="description"/>
				<field name="is_pathologique" invisible="1"/> 
				<field name="medecin_demander"/>
				<!--field name="move_id"  invisible="0" string="N° Fact"/>
				<field name="move_line_id"  invisible="1"/>
				<field name="etat_facturation"/-->
			</tree>
		</field>
	</record>
	
	<record id="view_labo_form" model="ir.ui.view">
		<field name="name">fertility.examen.labo.form</field>
		<field name="model">fertility.examen.labo</field>
		<field name="arch" type="xml">
			<form string="Laboratoire" create="false" edit="true">
				<header>
					<field name="status" widget="statusbar"/>
					<button name="action_sample_done" class="oe_highlight" type="object" 
						attrs="{'invisible': [('status', '!=', 'sample')]}" string="Valider" 
						groups="ksoftmedical.group_fertility_laboratoire"/>
					<button name="action_done" class="oe_highlight" type="object" 
					attrs="{'invisible': [('status', '!=', 'ongoing')]}" 
					groups="ksoftmedical.group_fertility_laboratoire" string="Valider" />
				</header>
				<sheet>
					<div>
						<h1 class="mt0">
							<field name="labo_name"  readonly="1"/>							
						</h1>
					</div>
					<div name="button_box" class="oe_button_box" groups="ksoftmedical.group_fertility_recept_labo">
                        <button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_partner_invoices"
                            context="{'default_partner_id': active_id}"
                            attrs="{'invisible':[('status','=','draft')]}">
                            <!--div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_invoiced" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Facturés</span>
                            </div-->
                        </button>
                    </div>
					<group>
						<group string="Patient">
							<field name="patient_id"  readonly="1"/>
							
							<field name="gender"  readonly="1"/>
							<field name="age"  readonly="1"/>
							<field name="categorie"  readonly="1"/>
							<field name="parent_id"  string="Convention" invisible="0"/>
							<field name="classe"  readonly="1"/>
							<field name="numero_billet"  readonly="0"/>
						</group>
						<group string="Prélèvement">			
							<field name="echantillon_num" attrs="{'readonly': [('status', '!=', 'sample')]}"/>
							<field name="date_prelevement" readonly="1"/>
							<field name="technicien_prelevement" readonly="1"/>
							<!--field name="echantillon" widget="many2manyattendee"  attrs="{'readonly': [('status', '!=', 'sample')]}"/-->
						</group>
					</group>
					<group string="Examen Laboratoire" 
					attrs="{'invisible': [('status', 'not in', ['sample','ongoing','done'])]}"
					groups="ksoftmedical.group_fertility_laboratoire">	
						
						<group>
							<field name="date_request"  readonly="1"/>
							<field name="type_analyse" readonly="1" />
							<field name="medecin_demander" readonly="1"/>
							<field name="analyse" readonly="1" />	
							<field name="clinique" readonly="1"/>
						</group>
						<group>
							
						</group>
					</group>
					<group string="Examen Laboratoire" groups="ksoftmedical.group_fertility_laboratoire"
					attrs="{'invisible': [('status', 'not in', ['ongoing','done'])]}">
						<group>
						<field name="date_analyse" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}"  string="Date de validation:"/>					
						<field name="technicien" readonly="1"  attrs="{'invisible': [('status', '!=', 'done')]}" string="Valider par:"/>
						<field name="description" attrs="{'readonly': [('status', '!=', 'ongoing')]}"/>
						<field name="is_pathologique"/>
						
						</group>
						<!--group>
							<button name="action_sample_done" class="oe_highlight" type="object" 
							string="Ajouter une valeur normale"/>
							<field name="valeur_normale" readonly="1"/>
						</group-->
					</group>					
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_externe_labo_tree" model="ir.ui.view">
		<field name="name">fertility.examen.externe.labo.tree</field>
		<field name="model">fertility.examen.labo.demande</field>
		<field name="arch" type="xml">
			<tree create="true">
				<field name="partner_id" string="client"/>
				<field name="patient_id"  />
				<field name="client_nom"  />
				<field name="nom"  readonly="0" invisible="1"/>
				<field name="postnom"  readonly="1" invisible="1"/>
				<field name="prenom"  readonly="1" invisible="1"/>
				<field name="birth"  readonly="0" />
				<field name="gender"  readonly="1"/>
				<field name="matricule"  readonly="1"/>
				<field name="categorie"  readonly="0"/>
				<field name="parent_id" string="Convention" />
			</tree>
		</field>
	</record>
	<record id="view_externe_labo_form" model="ir.ui.view">
		<field name="name">fertility.examen.externe.labo.form</field>
		<field name="model">fertility.examen.labo.demande</field>
		<field name="arch" type="xml">
			<form string="Laboratoire" create="true">
				<!--header>
					<field name="status" widget="statusbar"/>
					<button name="action_sample_done" class="oe_highlight" type="object" 
						attrs="{'invisible': [('status', '!=', 'draft')]}" string="Confirmer"/>
					
				</header-->
				<sheet>
					<group>
						<group string="Patient">
							<field name="partner_id" string="client"/>
							<field name="patient_id"  />
							<field name="client_nom"/>
							<field name="nom"  readonly="0"/>
							<field name="postnom"  readonly="1"/>
							<field name="prenom"  readonly="1"/>
							<field name="birth"  readonly="0"/>
							<field name="gender"  readonly="1"/>
							<field name="matricule"  readonly="1"/>
							<field name="categorie"  required="1"/>
							<field name="parent_id" string="Convention" 
							readonly="0" attrs="{'invisible': [('categorie', '!=', 'convention')], 'required': [('categorie', '=', 'convention')]}"/>
							<field name="numero_billet"  readonly="0"
							attrs="{'invisible': [('categorie', '!=', 'convention')], 'required': [('categorie', '=', 'convention')]}"/>
							<field name="email"  readonly="0"/>
							<field name="phone"  readonly="0"/>
							
						</group>
						<group string="Autres Informations">	
							<field name="doctor_id"  string = "Médecin demandeur"
								options="{'no_create': True, 'no_create_edit':True}" readonly="0"/>		
							<!--field name="echantillon_num" attrs="{'readonly': [('status', '!=', 'sample')]}"/>
							<field name="date_prelevement" readonly="1"/>
							<field name="technicien_prelevement" readonly="1"/-->
							<!--field name="echantillon" widget="many2manyattendee"  attrs="{'readonly': [('status', '!=', 'sample')]}"/-->
						</group>
					</group>
					

					<notebook>
						<page string="Examens demandés">
								<!--button name="ksoftmedical.action_imagerie_launchwizard" class="oe_highlight" type="action"
										string="Selectionner les analyses"/-->
								<button name="action_to_facturation" type="object" string="Envoyer à la caisse"/>

							<group string="Examens de laboratoire">
								<field name="labo_ids" nolabel="1">
									<tree editable="bottom" create="true">
										<field name="is_print"/>
										<field name="date_request" readonly="0"/>
										<field name="status" readonly="1" invisible="0"/>
										<field name="labo_name" readonly="0" invisible="1"/>
										<field name="type_analyse" readonly="1"/>
										<field name="analyse" domain="[('is_labo','=',True)]" 
											options="{'no_create': True, 'no_create_edit':True}" required="1"/>
										<!--field name="description" readonly="0"/-->
										<field name="valeur_normale" invisible="0" readonly="0"/>
										<field name="analyse_autres" invisible="1"/>
										<field name="examen_text" string="Clinique"/>
										<field name="move_id"  invisible="0" string="N° Fact"/>
										<field name="etat_facturation"/>
									</tree>
								</field>
							</group>
						</page>	
					</notebook>				
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_resultlabo_tree" model="ir.ui.view">
		<field name="name">fertility.examen.labo.tree</field>
		<field name="model">fertility.examen.labo</field>
