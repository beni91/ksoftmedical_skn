        <field name="res_model">fertility.wizard.dossier.medical.patient</field>
        <field name="view_mode">form</field>
        <field name="binding_view_types">form</field>
        <field name="target">new</field>
   </record>
   
   <record id="action_wizard_reporting_appointment_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_reporting_appointment_view"/>
        <field name="act_window_id" ref="action_wizard_reporting_appointment"/>
    </record>
    
   
