        <field name="name">wizard.reporting.appointment.view.form</field>
        <field name="model">fertility.wizard.dossier.medical.patient</field>
        <field name="arch" type="xml">
            <form string="">
                <!--button name="get_dossier_content" type="object" string="Afficher"/-->
                <sheet>
                    <!--group string="Identité patient">
						<group>
							<field name="patient_id" context="{'default_patient_id': patient_id}"/>
							<field name="nbre_ligne"/>
							<field name="see_resume"/>
							
						</group>
						<group>
							<field name="service" widget="selection"/>
							<field name="medecin" widget="selection"/>
							<field name="speciality" widget="selection" invisible="1"/>
						</group>
