<odoo>
	
	<record id="view_appointment_wizard" model="ir.ui.view">
		<field name="name">Nouvelle consultation</field>
		<field name="model">fertility.wizard.appointment</field>
		<field name="priority">1</field>
		<field name="arch" type="xml">
			<form string="Nouvelle consultation">
				<group col="4">
					<field name="patient_id" colspan="2" edit="False" create="False" widget="Many2one"/>
					<field name="doctor_id" colspan="2" edit="False" create="False" widget="Many2one"/>
				</group>
				<footer>
					<button name="action_create" string="Créer une consultation" type="object" class="oe_highlight"/>
					or
					<button string="Annuler" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="action_appointment_launchwizard" model="ir.actions.act_window">
		<field name="name">Nouvelle consultation</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">fertility.wizard.appointment</field>
		<field name="binding_view_types">form</field>
		<field name="view_mode">form</field>
		<field name="view_id" ref="view_appointment_wizard"/>
		<field name="target">new</field>
		<field name="context">{'default_appointment_type':active_id}</field>
	</record>


	<record id="view_appointment_form" model="ir.ui.view">
		<field name="name">fertility.appointment.form</field>
		<field name="model">fertility.appointment</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div>
						<h3 class="mt0">
							<field name="name"/>
							<field name="date"/>
						</h3>
					</div>
					<group string="Identification du patient">
						<group id="header_left_group">
							<field name="patient_id"/>
						</group>
					</group>
					<notebook>
						<page id="param_ids_nurse" string="Signes vitaux">
							<group id="header_left_group">						
								<field name="weight"/>
								<field name="height"/>
								<field name="systolic"/>
								<field name="diastolics"/>
								<field name="hip"/>
								<field name="bmi"/>
								<field name="temperature"/>
							</group>
						</page>

						<page id="param_ids_doctor" string="Consultation">
							
						</page>

						<page id="antecedent_ids" string="Antécédents">
							
						</page>
						<page id="antecedent_ids" string="Consultation sociale">								
						</page>
						<page id="antecedent_ids" string="Consultation gynécologique">								
						</page>
						<page id="antecedent_ids" string="Examen Labo">								
						</page>
						<page id="antecedent_ids" string="Examen Imagerie">								
						</page>
					</notebook>			
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_appointment_tree" model="ir.ui.view">
		<field name="name">fertility.appointment.tree</field>
		<field name="model">fertility.appointment</field>
		<field name="arch" type="xml">
			<tree>
				<field name="date"/>
				<field name="name"/>
				<field name="patient_id"/>
				<field name="doctor_id"/>
				<field name="appointment_type"/>
				
			</tree>
		</field>
	</record>


	<record id="action_appointment_today" model="ir.actions.act_window">
		<field name="name">Prévu aujourd'hui</field>
		<field name="res_model">fertility.appointment</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('appointment_type','=',active_id),('date','=',context_today())]</field> 
	</record>

	<record id="view_appointment_type_kanban" model="ir.ui.view">
		<field name="name">fertility.appointment.type.kanban</field>
		<field name="model">fertility.appointment.type</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_dashboard o_appointment_kanban" sample="1">
				<field name="name"/>
				<field name="count_appointment"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click">
							<div class="o_kanban_card_header">
								<div class="o_kanban_card_header_title">
									<div class="o_primary col-12 p-0 w-75">
										<field name="name"/>
									</div>
								</div>
							</div>
							<div class="container o_kanban_card_content mt-3">
								<div class="row">
									<div class="col-6 o_kanban_primary_left">
										<button class="btn btn-primary mr-2" name="fertility.action_appointment_launchwizard" type="action">
											<span>Nouveau RDV</span>
										</button>
									</div>
									<div class="col-6 o_kanban_primary_right">
										<div class="row">
											<a name="fertility.action_appointment_today" type="action"><span><t t-esc="record.count_appointment.value"/> Prévu aujourd'hui</span></a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>


	<record id="view_patient_tree" model="ir.ui.view">
		<field name="name">fertility.patient.tree</field>
		<field name="model">fertility.patient</field>
	
		<field name="arch" type="xml">
			<tree string="Contacts" >
				<field name="display_name" string="Name"/>
				<field name="name"/>
				<field name="function" invisible="1"/>
				<field name="prenom"/>
				<field name="nom"/>
				<field name="postnom"/>
				<!--field name="email" optional="show"/>
				<field name="user_id" optional="show" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
				<field name="city" optional="show"/>
				<field name="state_id" optional="hide" readonly="1"/>
				<field name="country_id" optional="show" readonly="1"/>
				<field name="vat" optional="hide" readonly="1"/>
				<field name="category_id" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
				<field name="company_id" groups="base.group_multi_company" readonly="1"/>
				<field name="is_company" invisible="1"/>
				<field name="parent_id" invisible="1" readonly="1"/>
				<field name="active" invisible="1"/-->
			</tree>
		</field>
	</record>


	<record id="view_patient_form" model="ir.ui.view">
		<field name="name">fertility.patient.form</field>
		<field name="model">fertility.patient</field>
		<field name="arch" type="xml">
			<form>
				<div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('same_vat_partner_id', '=', False)]}">
				  A partner with the same <span><span class="o_vat_label">Tax ID</span></span> already exists (<field name="same_vat_partner_id"/>), are you sure to create a new one?
				</div>
				<sheet>
					<widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
					<div class="oe_title mb24">
						
						<field name="is_company" invisible="1"/>
						<field name="commercial_partner_id" invisible="1"/>
						<field name="active" invisible="1"/>
						<!--field name="country_code" invisible="1"/-->
						<h1>
							<field id="name" class="o_text_overflow" name="name" attrs="{'readonly' : True}"/>
						</h1>
						<div class="o_row">
							<field id="matricule" class="o_text_overflow" name="name" attrs="{'readonly' : True}"/>
						</div>
					</div>

					<notebook colspan="4">
						<page string="Identification" name="historic" autofocus="autofocus">
							<group>
								<group>
									<field name="prenom" placeholder="Prénom"/>
									<field name="nom" placeholder="Nom"/>
									<field name="postnom" placeholder="Postnom"/>
									<field name="birth" placeholder="Date de naissance"/>
									<span class="o_form_label o_td_label" name="address_name">
										<b>Adresse</b>
									</span>
									<div class="o_address_format">
										<field name="street" placeholder="Street..." class="o_address_street" />
										<field name="street2" placeholder="Street 2..." class="o_address_street" />
										<field name="city" placeholder="City" class="o_address_city" />
										<field name="quartier" class="o_address_state" placeholder="Quartier" />
										<field name="commune" placeholder="Commune" class="o_address_zip" options="{'no_open': True, 'no_quick_create': True}"/>
										<field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
									</div>

									
								</group>
								<group>
									<field name="phone" widget="phone"/>
									<field name="email" widget="email"/>
									<field name="function" />
									<field name="title" options='{"no_open": True}' placeholder="e.g. Mister" attrs="{'invisible': [('is_company', '=', True)]}"/>
			
									<field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Tags..."/>
								</group>
							</group>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>


	<record id="action_patient_tree" model="ir.actions.act_window">
		<field name="name">Patient</field>
		<field name="res_model">fertility.patient</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>

	<record id="action_appointment_dashboard" model="ir.actions.act_window">
		<field name="name">Rendez-vous</field>
		<field name="res_model">fertility.appointment.type</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">kanban</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>

	<menuitem id="menu_reception" sequence="10" groups="base.group_user"
		name="Reception" />

		<menuitem id="menu_consultation" parent="menu_reception" groups="base.group_user" action="action_appointment_dashboard"
			sequence="1"
			name="Consultation" />

		<menuitem id="menu_patient" parent="menu_reception" groups="base.group_user" action="action_patient_tree"
			sequence="2"
			name="Patient"  />


</odoo>