		<field name="view_mode">tree,form</field>
		<field name="domain">[('state','=','out')]</field>
		<field name="context">{}</field>
	</record-->

	<menuitem id="menu_statisques" parent="ksoftmedical.menu_config" groups="base.group_user" sequence="1"
			name="Statistiques" />

			<menuitem id="menu_prescription_cfg" parent="menu_statisques" groups="base.group_user" 
				action="action_prescription_medicale"
				sequence="1"
				name="Prescriptions Médicales" />

