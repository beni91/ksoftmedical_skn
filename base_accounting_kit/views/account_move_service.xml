<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_rubrique_tree" model="ir.ui.view">
		<field name="name">rubrique.tree</field>
		<field name="model">module.rubrique</field>
		<field name="arch" type="xml">
			<tree>
				<field name="code" />
				<field name="name" />
				<field name="service_id" />
			</tree>
		</field>
	</record>

	<record id="view_rubrique_form" model="ir.ui.view">
		<field name="name">rubrique.form</field>
		<field name="model">module.rubrique</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" /></h1>
					</div>
					<group>
						<field name="code" />
						<field name="service_id" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_service_tree" model="ir.ui.view">
		<field name="name">service.tree</field>
		<field name="model">module.service</field>
		<field name="arch" type="xml">
			<tree>
				<field name="code" />
				<field name="name" />
			</tree>
		</field>
	</record>

	<record id="view_service_form" model="ir.ui.view">
		<field name="name">service.form</field>
		<field name="model">module.service</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" /></h1>
					</div>
					<group>
						<field name="code" />
					</group>
					<group>
						<group string="Médecin">
							<field name="medecin" nolabel="1"  readonly="1">
								<tree editable="bottom">
                                     <field name="cnom"/>
									 <field name="name"/>
								</tree>
							</field>
						</group>
						<group string="Rubriques">
							<field name="rubrique" nolabel="1" readonly="1">
								<tree editable="bottom">
                                     <field name="code"/>
									 <field name="name"/>
								</tree>
							</field>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>
	
	<record id="view_medecin_tree" model="ir.ui.view">
		<field name="name">medecin.tree</field>
		<field name="model">module.doctor</field>
		<field name="arch" type="xml">
			<tree>
				<field name="cnom" />
				<field name="name" />
				<field name="service_id" />
			</tree>
		</field>
	</record>

	<record id="view_medecin_form" model="ir.ui.view">
		<field name="name">medecin.form</field>
		<field name="model">module.doctor</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" /></h1>
					</div>
					<group>
						<field name="cnom" />
						<field name="service_id" required="1"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_service_invoice" model="ir.actions.act_window">
		<field name="name">Service</field>
		<field name="res_model">module.service</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>


	<record id="action_doctor_invoice" model="ir.actions.act_window">
		<field name="name">Medecin</field>
		<field name="res_model">module.doctor</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>
	
	
	<record id="action_rubrique_invoice" model="ir.actions.act_window">
		<field name="name">Rubriques</field>
		<field name="res_model">module.rubrique</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="domain"></field> 
		<field name="context">{}</field>
	</record>

	<menuitem id="account_service_menu" sequence="1"
                  name="Service Medical" parent="account.menu_finance_reports"/>
				  
		<menuitem id="account_service_invoicing" sequence="1"
                  name="Service Médical" parent="account_service_menu"
				  action="action_service_invoice"/>
				  
		<menuitem id="account_doctor_invoicing" sequence="5"
                  name="Docteur" parent="account_service_menu"
				  action="action_doctor_invoice"/>
				  
		<menuitem id="account_rubrique_invoicing" sequence="5"
                  name="Rubriques" parent="account_service_menu"
				  action="action_rubrique_invoice"/>
				  
				  


</odoo>