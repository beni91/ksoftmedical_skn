<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="res.groups" id="group_account_dashboard">
            <field name="name">Access to Accounting Dashboard</field>
        </record>

        <record id="account_asset_category_multi_company_rule" model="ir.rule">
            <field name="name">Account Asset Category multi-company</field>
            <field ref="model_account_asset_category" name="model_id"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]
            </field>
        </record>

        <record id="account_asset_asset_multi_company_rule" model="ir.rule">
            <field name="name">Account Asset multi-company</field>
            <field ref="model_account_asset_asset" name="model_id"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]
            </field>
        </record>
        <!--    Rename user group as Accountant    -->
        <record id="account.group_account_user" model="res.groups">
            <field name="name">Accountant</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
        </record>

        <!--    Rename user group as Chief Accountant    -->
        <record id="account.group_account_manager" model="res.groups">
            <field name="name">Chief Accountant</field>
            <field name="implied_ids"
                   eval="[(3, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
        </record>
		
		
	<record id="module_category_ngaliema" model="ir.module.category">
		<field name="name">Profil Ngaliema</field>
		<field name="description">Ngaliema</field>
		<field name="sequence">4</field>
	</record>
	
	<record id="group_ngaliema_comptabilite" model="res.groups">
		<field name="name">Comptable</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	<record id="group_ngaliema_resfacturation" model="res.groups">
		<field name="name">Resp. Facturation</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	<record id="group_ngaliema_cassier" model="res.groups">
		<field name="name">Caisier</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	
	<record id="group_ngaliema_cassier_labo" model="res.groups">
		<field name="name">Caisier Laboratoire</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	<record id="group_ngaliema_cassier_consultprinter" model="res.groups">
		<field name="name">Rapport Consultations</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	<record id="group_ngaliema_cassier_laboprinter" model="res.groups">
		<field name="name">Rapport laboratoire</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	<record id="group_ngaliema_cassier_maternitprinter" model="res.groups">
		<field name="name">Rapport Maternité</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	<record id="group_ngaliema_cassier_imagerprinter" model="res.groups">
		<field name="name">Rapport Imagerie</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	<record id="group_ngaliema_cassier_pharmacie" model="res.groups">
		<field name="name">Rapport Pharmacie</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	<record id="group_ngaliema_cassier_gardeprinter" model="res.groups">
		<field name="name">Rapport Garde</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	<record id="group_ngaliema_responsable" model="res.groups">
		<field name="name">Responsable</field>
		<field name="category_id" ref="module_category_ngaliema"/>
	</record>
	
	
	<!-- Empecher le comptable de modifier les factures.-->
    <record id="account_move_rule_group_readonly2" model="ir.rule">
        <field name="name">Comptable Move</field>
        <field name="model_id" ref="model_account_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base_accounting_kit.group_ngaliema_comptabilite')),
									(4, ref('base_accounting_kit.group_ngaliema_resfacturation'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
	
	<record id="account_move_line_rule_group_readonly2" model="ir.rule">
        <field name="name">Comptable Move Line</field>
        <field name="model_id" ref="model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base_accounting_kit.group_ngaliema_comptabilite')),
									(4, ref('base_accounting_kit.group_ngaliema_resfacturation'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
	
    </data>
</odoo>
