        <template id="report_facture_convention_template">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page">

                         <t t-foreach="report_infos" t-as="report">
                            <div>

                                <h5 >
                                    <center>
                                        <h4>RAPPORT PERIODIQUE CONVENTION</h4>
                                    </center>
                                    <p></p>
                                    <center>
                                        DU <b><t t-esc="report_infos[0]['date_debut']"/></b> AU <b><t t-esc="report_infos[0]['date_fin']"/></b>
                                        <br/>
                                        <center>CONVENTION: <b><t t-esc="report_infos[0]['convention_id']"/></b> </center>
                                    </center>
                                </h5>
                                
                                <br/>

                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Patient</th>
                                            <th>Réf Facture</th>
                                            <th>Date</th>
                                            <!-- <th>Devise</th> -->
                                            <th>Acte</th>
                                            <th>Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                                        <t t-foreach="factures" t-as="partner_data">
                                            <tr>
                                                <td colspan="4"><t t-esc="partner_data['partner']"/></td>
                                                <!-- <td><b>Total:</b> <t t-esc="som"/><t t-esc="devise"/></td> -->
                                            </tr>
                                            <t t-foreach="partner_data['invoices']" t-as="invoice">
                                                <tr>
                                                    <td></td>
                                                    <td><t t-esc="invoice['ref']"/></td>
                                                    <td><t t-esc="invoice['date']"/></td>
                                                    <td></td>
                                                </tr>
                                                <t t-foreach="invoice['lignes_de_facture']" t-as="ligne">
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <!-- <td></td> -->
                                                        <td><t t-esc="ligne['produit']"/></td>
                                                        <td><t t-esc="ligne['prix']"/><t t-esc="devise"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </tbody>
                                </table><br/>
								<center>
                                    MONTANT GENERAL : <b><t t-esc="montant_global"/> <t t-esc="devise"/></b>
                                </center>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </template>


    </data>
