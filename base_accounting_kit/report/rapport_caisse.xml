<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Rapport comptabilité periodique  -->
    <record id="view_releve_vente_pharmacie_wizard" model="ir.ui.view">
        <field name="name">Rélevé de Vente Pharmacie</field>
        <field name="model">account.cash.report</field>
        <field name="arch" type="xml">
            <form string="Rapport Comptable">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date_pharma" />
							
                        </group>
                        <group>
                            <field name="code_jour" 
							domain="[('date_ouverture','=',start_date),('date_fermeture','=',end_date_pharma),('internal_status','=','close')]" 
							widget="selection"
							required="1"/>
							
							<!--field name="convention" domain="[('is_company','=',True)]" 
							/-->
							
                        </group>
                    </group>
					
					<field name="convention_ids" string="Selectionnez une convention"/>

                </sheet>
                <footer>
                    <button name="compta_convention_report_print" string="Rapport Convention PDF" type="object" class="btn-primary"/>
                    <button name="compta_private_report_print" string="Rapport Privé PDF" type="object" class="btn-primary"/>
					<!--button name="change_society_to_person" string="Societe to Individual" type="object" class="btn-primary"/-->
					
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>


