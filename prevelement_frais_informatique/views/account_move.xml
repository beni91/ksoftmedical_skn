<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>           
        <record id="view_acc_move_form" model="ir.ui.view">
            <field name="name">AccountMove Form</field>
            <field name="model">account.move</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="before">
                    <field name="select" readonly="0" force_save="1" attrs="{'readonly' : [('etat','=',True)]}"/>  
 				</xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
                    <field name="etat" force_save="1" />  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>  
                    <attribute name="options">{'no_create_edit': true}</attribute>  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>  
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute> 
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': [('etat','=',True)]}</attribute>
 				</xpath>

                <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                    <attribute name="attrs">{'readonly' : [('state','=','cancel')] }</attribute>
 				</xpath>


            </field>
        </record>

        <!--<record id="view_payment_form" model="ir.ui.view">
            <field name="name">account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='amount']" position="attributes">
                   <attribute name="attrs">{'readonly': 1}</attribute> 
                </xpath>

            </field>
        </record-->

        <record id="view_id_payment_register_form" model="ir.ui.view">
            <field name="name">account.payment.register.form</field>
            <field name="model">account.payment.register</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='amount']" position="attributes">
                   <attribute name="attrs">{'readonly': 0}</attribute> 
                </xpath>

                <xpath expr="//field[@name='amount']" position="after">
                   <field name="frais_info" readonly="1" force_save="1"/>
                </xpath>

            </field>
        </record>

        <record id="view_accou_move_form" model="ir.ui.view">
            <field name="name">AccountMove Form</field>
            <field name="model">account.move</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="before">
                    <field name="is_prelever" />
                </xpath>

            </field>
        </record>
        
        
    </data>
</odoo>