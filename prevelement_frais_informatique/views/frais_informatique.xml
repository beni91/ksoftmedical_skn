<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!--menuitem id="frais_informatique_menu_root"
                  name="Frais Informatique"
				  groups="ksoftmedical.group_ksoft_admin"
                  web_icon="prevelement_frais_informatique,static/description/icon.png"
                  sequence="55"/-->

	<record model="ir.ui.view" id="search_frais_informatique">
		<field name="name">frais.informatique.search</field>
		<field name="model">frais.informatique</field>
		<field name="arch" type="xml">
			<search>
				<field name="partner_id" />
				<field name="date" />
				<field name="state" />
				<filter name="current_month" string="Mois" domain="[('date', '&lt;',(context_today()+relativedelta(months=1)).strftime('%%Y-%%m-01')),('date','&gt;=',time.strftime('%%Y-%%m-01'))]" />
				<filter name="prev_month" string="Mois Passé" domain="[('date', '&gt;=',(context_today()-relativedelta(months=1)).strftime('%%Y-%%m-01')),('date','&lt;',time.strftime('%%Y-%%m-01'))]" />
				<filter name="group_by_state" string="Etat" icon="terp-partner" context="{'group_by':'state'}"/>
			</search>
		</field>
	</record>
	<record id="frais_informatique_tree_view" model="ir.ui.view">
		<field name="name">frais.informatique.tree.view</field>
		<field name="model">frais.informatique</field>
		<field name="arch" type="xml">
			<tree string="Frais Informatique" create="0" delete="0" edit="0">
				<field name="num_op"/>
				<field name="num_fac"/>
				<field name="date"/>
				<field name="partner_id"/>
				<field name="montant_paie"/>
				<field name="frais_informatique" sum="Total"/>
				<field name="state"/>
			</tree>
		</field>
	</record>
	<record model="ir.actions.act_window" id="action_frais_informatique">
		<field name="name">Frais Informatique</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">frais.informatique</field>
		<field name="context">{'search_default_current_month': True, 'search_default_group_by_state': 1}</field>
		<field name="search_view_id" ref="search_frais_informatique"/>
		<field name="view_mode">tree</field>
	</record>

	<!--menuitem id="frais_inf_menu"
        name="Visualiser"
        parent="frais_informatique_menu_root"
    	sequence="1" action="action_frais_informatique"/>
	<menuitem id="frais_inf_config"
        name="Parametrage"
        parent="frais_informatique_menu_root"
        action="configuration_action"
        sequence="1000"/-->
</odoo>