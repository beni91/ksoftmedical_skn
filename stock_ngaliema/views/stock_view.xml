<?xml version="1.0" encoding="utf-8"?>
<odoo>
       
	<record id="stock_picking_form_view2" model="ir.ui.view">
		<field name="name">stock.picking.form2</field>
        <field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form"/>
		<field name="arch" type="xml">
			<div class="o_td_label" position="replace">
				<label for="partner_id" string="Service demandeur" style="font-weight:bold;"
					   attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
				<label for="partner_id" string="Receive From" style="font-weight:bold;"
					   attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
				<label for="partner_id" string="Service" style="font-weight:bold;"
					   attrs="{'invisible': [('picking_type_code', 'in', ['incoming', 'outgoing'])]}"/>
			</div>
		</field>
	</record>



</odoo>
