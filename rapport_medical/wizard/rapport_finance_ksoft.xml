<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!-- DG CAISSE -->
	   <!-- DG : Rapport de caisse prive -->
    <record id="view_dg_dailybook_wizard" model="ir.ui.view">
        <field name="name">Rapport de Caisse privé</field>
        <field name="model">account.cash.report</field>
        <field name="arch" type="xml">
            <form string="Daily Report">
				<header>
				<!--button name="get_consultation_global_prive" string="R. caisse global" type="object" class="btn-primary"/-->
				<button name="get_final_detail_prive" string="R. caisse détaillé" type="object" class="btn-primary"/>
				<!--button name="dailybook_print" string="Impression PDF" type="object" class="btn-primary"/-->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group>
                            <field name="journal" domain="[('type','=','sale')]" required="1"/>
                            <field name="journal_payement" domain="[('type', 'in', ('bank', 'cash'))]"/>

                        </group>
                    </group>
					<group>
						<field name="contenu" string="Rapport" nolabel="1" readonly="1"/>
					</group>

                </sheet>
            </form>
        </field>
    </record>
	
	<!-- DG : Rapport de caisse Convention  -->
    <record id="view_dg_convdailybook_wizard" model="ir.ui.view">
        <field name="name">Rapport de Caisse convention</field>
        <field name="model">account.cash.report</field>
        <field name="arch" type="xml">
            <form string="Daily Report">
				<header>
				<!--button name="get_consultation_global_convention" string="R. Global Convention" type="object" class="btn-success"/-->
				<button name="get_final_detail_convention" string="R. Détaillé Convention" type="object" class="btn-success"/>
				<!--button name="dailybook_print" string="Impression PDF" type="object" class="btn-primary"/-->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                        </group>
                        <group>
                            <field name="convention" domain="[('is_company','=','true')]" required="1"/>
                            <!--field name="journal_payement" domain="[('type', 'in', ('bank', 'cash'))]"/-->

                        </group>
                    </group>
					<group>
						<field name="contenu" string="Rapport" nolabel="1" readonly="1"/>
					</group>

                </sheet>
            </form>
        </field>
    </record>
	
	<!-- FIN CAISSE -->

	<!-- DEBUT STATISTIQUE -->
	<!-- Pharmacie -->
	<record id="view_prescription_medical_tree" model="ir.ui.view">
		<field name="name">module.prescription.line.tree</field>
		<field name="model">module.ordonnance.line</field>
		<field eval="8" name="priority"/>
		<field name="arch" type="xml">
			<tree string="Prescirption" 
				create="false" edit="false" delete="false" sample="1" multi_edit="1">
				<field name="date_ordonnance" />
				<field name="patient_id" />
				<field name="age" />
				<field name="categorie" />
				<field name="parent_id" />
				<field name="product" />
				<field name="posologie" />
				<field name="quantity" string="Qté Demandée"/>
				<field name="quantity2" string="Qté Servie"/>
				<field name="medecin_id"/>
			</tree>
		</field>
	</record>
	
	<record id="view_prescription_medical_search" model="ir.ui.view">
        <field name="name">module.prescription.line.search</field>
		<field name="model">module.ordonnance.line</field>
        <field name="arch" type="xml">
            <search string="Search Rendez-vous">
                <field name="date_ordonnance" />
				<field name="patient_id" />
				<field name="categorie" />
				<field name="parent_id" />
				<field name="product" />
				<field name="medecin_id"/>


                <!--group string="Group By"-->
                    <!--filter string="Genre" name="group_by_gender" context="{'group_by':'gender'}"/--> <!--Ici on a crée un group by-->
                <!--/group-->
                <group string="Group By">
                    <filter string="Date de prescription" name="group_by_DateRDV" context="{'group_by':'date_ordonnance'}"/>
					<filter string="Patient" name="group_by_Patient" context="{'group_by':'patient_id'}"/>
					<filter string="Médecin" name="group_by_eMeecin" context="{'group_by':'medecin_id'}"/>
					<filter string="Convention" name="group_by_Convention" context="{'group_by':'parent_id'}"/>
					<filter string="Produit" name="group_by_Cas" context="{'group_by':'product'}"/>
				</group>
            </search>
        </field>
    </record>
	<!-- FIN STATISTIQUE -->


	<record id="action_dg_dailybook_wizard" model="ir.actions.act_window">
        <field name="name">Rélevé de Vente</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.cash.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dg_dailybook_wizard"/>
        <field name="target"></field>
    </record>
	
	<record id="action_dg_convdailybook_wizard" model="ir.actions.act_window">
        <field name="name">Rélevé de Vente</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.cash.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dg_convdailybook_wizard"/>
        <field name="target"></field>
    </record>
	
	<record id="action_prescription_medical" model="ir.actions.act_window">
        <field name="name">Statistique de prescription</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">module.ordonnance.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_prescription_medical_tree"/>
		<field name="search_view_id" ref="view_prescription_medical_search"/>
        <field name="target"></field>
    </record>
